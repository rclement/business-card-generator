{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":disableDependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "rangeStrategy": "bump",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "minimumReleaseAge": null,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Python dependencies automerge (minor, patch)",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependencies",
        "dependency-groups"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python dependencies",
      "automerge": true
    },
    {
      "description": "GitHub Actions automerge (minor, patch, digest)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Docker images automerge (patch)",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Python version automerge (minor, patch)",
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "assignees": [
        "rclement"
      ],
      "reviewers": [
        "rclement"
      ]
    }
  ]
}
